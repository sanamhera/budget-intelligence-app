PORT=4000
JWT_SECRET=mySuperSecretKey12345

# MongoDB — database name defaults to nacl-buget-intelligence (override with MONGO_DB_NAME)
MONGO_DB_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nacl-buget-intelligence

# Vertex AI Gemini (GCP billing via ADC — no AI Studio API key)
GOOGLE_CLOUD_PROJECT=nacl-business-intelligence
GOOGLE_CLOUD_LOCATION=asia-south1

# GCS PDF storage
GCS_BUCKET=nacl-budget-intelligence-pdfs
